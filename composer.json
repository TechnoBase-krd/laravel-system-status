{
    "name": "technobase/laravel-system-status",
    "description": "Self-hosted status page, uptime monitor and incident tracker for Laravel: health checks, real traffic, automatic incidents, Telegram / Slack / Discord alerts, SLA reports and security monitoring.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "status-page",
        "statuspage",
        "system-status",
        "monitoring",
        "uptime",
        "uptime-monitor",
        "health-check",
        "incidents",
        "incident-management",
        "alerts",
        "telegram",
        "slack",
        "sla",
        "maintenance",
        "security",
        "laravel-package"
    ],
    "authors": [
        {
            "name": "TechnoBase",
            "homepage": "https://github.com/TechnoBase-krd"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "spatie/laravel-health": "^1.29"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "suggest": {
        "laravel-notification-channels/telegram": "Sends status changes to a Telegram chat.",
        "spatie/laravel-permission": "Provides hasRole() for the page's role check.",
        "barryvdh/laravel-dompdf": "Adds PDF export to the monthly uptime report.",
        "laravel/pulse": "Shows a System Status card on the Pulse dashboard."
    },
    "autoload": {
        "psr-4": {
            "Technobase\\SystemStatus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Technobase\\SystemStatus\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        },
        "files": [
            "tests/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Technobase\\SystemStatus\\SystemStatusServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test --preset laravel src config routes lang database tests",
        "format": "pint --preset laravel src config routes lang database tests",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench workbench:build --ansi",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
